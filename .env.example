# ─────────────────────────────────────────────────────────────────────────────
# GOLF CHARITY PLATFORM — Environment Variables Template
# Copy this file to .env.local and fill in your values.
# NEVER commit .env or .env.local to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (Auth + Storage) ─────────────────────────────────────────────────
# From: Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ── Neon PostgreSQL (Primary Database) ───────────────────────────────────────
# From: Neon Console → Connection Details (use pooled connection for app)
DATABASE_URL=postgresql://user:password@ep-your-endpoint-pooler.region.aws.neon.tech/dbname?sslmode=require&connect_timeout=30&pool_timeout=30
DIRECT_URL=postgresql://user:password@ep-your-endpoint.region.aws.neon.tech/dbname?sslmode=require&connect_timeout=30

# ── AI Providers (Server-side only — never prefix with NEXT_PUBLIC_) ─────────
# From: Google AI Studio → API Keys
GEMINI_API_KEY=your_gemini_api_key_here

# From: OpenAI Platform → API Keys
OPENAI_API_KEY=your_openai_api_key_here

# ── Razorpay (Payment Gateway) ───────────────────────────────────────────────
# From: Razorpay Dashboard → Settings → API Keys
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret_here

# The public key is safe to expose to the browser for Razorpay Checkout
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id

# ── Application ───────────────────────────────────────────────────────────────
# The canonical URL of your app (no trailing slash)
# For local dev: http://localhost:3000
# For production: https://your-domain.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Security ──────────────────────────────────────────────────────────────────
# A random secret used for CSRF / webhook verification (generate with: openssl rand -hex 32)
INTERNAL_WEBHOOK_SECRET=your_random_secret_here
