generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
// ─────────────────────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────────────────────

enum UserRole {
  ADMIN
  DONOR
  PENDING_ORGANIZER
  ORGANIZER
}

enum VerificationStatus {
  DRAFT
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum OrganizationType {
  NGO
  TRUST
  SOCIETY
  COMPANY
  FOUNDATION
  EDUCATIONAL
  RELIGIOUS
  INDIVIDUAL
  OTHER
}

enum DocumentType {
  REGISTRATION_CERTIFICATE
  PAN_CARD
  GST_CERTIFICATE
  TAX_EXEMPTION_CERTIFICATE
  BANK_PROOF
  GOVERNMENT_CERTIFICATE
  OTHER
}

enum CampaignStatus {
  DRAFT
  PENDING_APPROVAL
  ACTIVE
  COMPLETED
  CANCELLED
  REJECTED
}

enum DonationStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum PaymentGateway {
  MOCK
  RAZORPAY
  STRIPE
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
}
// ─────────────────────────────────────────────────────────────────────────────
// PROFILE
// One row per authenticated user.
// Created automatically after signup.
// Authentication is handled separately.
// Business logic should never modify roles directly.
// ─────────────────────────────────────────────────────────────────────────────

model Profile {
  id                 String             @id @db.Uuid

  fullName           String             @map("full_name")
  email              String             @unique
  avatarUrl          String?            @map("avatar_url")

  role               UserRole           @default(DONOR)

  verificationStatus VerificationStatus
                     @default(PENDING)
                     @map("verification_status")

  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  // Relations
  organization       Organization?

  campaigns          Campaign[]

  donations          Donation[]

  // Indexes
  @@index([role])

  @@index([verificationStatus])

  @@index([createdAt])

  @@map("profiles")
}
// ─────────────────────────────────────────────────────────────────────────────
// ORGANIZATION
// Represents an organization owned by one user.
// Only verified organizations can create fundraising campaigns.
// ─────────────────────────────────────────────────────────────────────────────

model Organization {
  id                 String             @id @default(uuid()) @db.Uuid

  // Owner
  profileId          String             @unique @map("profile_id") @db.Uuid
  profile            Profile            @relation(fields: [profileId], references: [id], onDelete: Cascade)

  // ───────────────────────────────
  // Basic Information
  // ───────────────────────────────

  name               String
  type               OrganizationType   @default(OTHER)

  description        String             @db.Text

  website            String?

  email              String             @unique

  phone              String

  // ───────────────────────────────
  // Address
  // ───────────────────────────────

  address            String

  city               String

  state              String

  country            String             @default("India")

  postalCode         String             @map("postal_code")

  // ───────────────────────────────
  // Legal Information
  // ───────────────────────────────

  registrationNo     String             @unique @map("registration_no")

  panNumber          String             @unique @map("pan_number")

  gstNumber          String?            @unique @map("gst_number")

  taxExemptionNo     String?            @map("tax_exemption_no")

  // ───────────────────────────────
  // Bank Details
  // ───────────────────────────────

  accountHolder      String             @map("account_holder")

  accountNumber      String             @map("account_number")

  bankName           String             @map("bank_name")

  ifscCode           String             @map("ifsc_code")

  branchName         String             @map("branch_name")

  // ───────────────────────────────
  // Branding
  // ───────────────────────────────

  logoUrl            String?            @map("logo_url")

  coverImageUrl      String?            @map("cover_image_url")

  // ───────────────────────────────
  // Verification
  // ───────────────────────────────

  verificationStatus VerificationStatus
                     @default(DRAFT)
                     @map("verification_status")

  submittedAt        DateTime?
                     @map("submitted_at")

  reviewedAt         DateTime?
                     @map("reviewed_at")

  adminNotes         String?
                     @db.Text
                     @map("admin_notes")

  // ───────────────────────────────
  // Soft Delete
  // ───────────────────────────────

  deletedAt          DateTime?
                     @map("deleted_at")

  // ───────────────────────────────
  // Metadata
  // ───────────────────────────────

  createdAt          DateTime
                     @default(now())
                     @map("created_at")

  updatedAt          DateTime
                     @updatedAt
                     @map("updated_at")

  // Relations

  campaigns          Campaign[]

  documents          OrganizationDocument[]

  // Indexes

  @@index([profileId])

  @@index([verificationStatus])

  @@index([name])

  @@index([createdAt])

  @@map("organizations")
}
// ─────────────────────────────────────────────────────────────────────────────
// ORGANIZATION DOCUMENT
// Stores every document uploaded by an organization.
// Each document has its own verification lifecycle.
// ─────────────────────────────────────────────────────────────────────────────

model OrganizationDocument {
  id                 String               @id @default(uuid()) @db.Uuid

  organizationId     String               @map("organization_id") @db.Uuid
  organization       Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Document Information

  documentType       DocumentType         @map("document_type")

  originalFileName   String               @map("original_file_name")

  storagePath        String               @unique @map("storage_path")

  mimeType           String               @map("mime_type")

  fileSize           Int                  @map("file_size")

  // Verification

  verificationStatus VerificationStatus   @default(PENDING) @map("verification_status")

  reviewedAt         DateTime?            @map("reviewed_at")

  reviewerNotes      String?              @db.Text @map("reviewer_notes")

  // Metadata

  uploadedAt         DateTime             @default(now()) @map("uploaded_at")

  updatedAt          DateTime             @updatedAt @map("updated_at")

  // Indexes

  @@index([organizationId])

  @@index([documentType])

  @@index([verificationStatus])

  @@index([uploadedAt])

  @@map("organization_documents")
}
// ─────────────────────────────────────────────────────────────────────────────
// CAMPAIGN
// Fundraising campaign created by a verified organization.
// ─────────────────────────────────────────────────────────────────────────────

model Campaign {
  id               String           @id @default(uuid()) @db.Uuid

  // Owner
  organizerId      String           @map("organizer_id") @db.Uuid
  organizer         Profile         @relation(fields: [organizerId], references: [id])

  organizationId   String           @map("organization_id") @db.Uuid
  organization      Organization    @relation(fields: [organizationId], references: [id])

  // Basic Information
  title            String
  slug             String           @unique
  category         String

  shortDescription String           @map("short_description")
  description      String           @db.Text
  story            String?          @db.Text

  // Beneficiary
  beneficiaryName  String?          @map("beneficiary_name")
  beneficiaryStory String?          @db.Text @map("beneficiary_story")

  // Location
  location         String?

  // Images
  coverImageUrl    String?          @map("cover_image_url")

  // Financial
  goalAmount       Decimal          @db.Decimal(12,2) @map("goal_amount")
  currentAmount    Decimal          @default(0) @db.Decimal(12,2) @map("current_amount")

  // Campaign State
  status           CampaignStatus   @default(DRAFT)

  featured         Boolean          @default(false)

  // Timeline
  startDate        DateTime         @db.Date @map("start_date")
  endDate          DateTime         @db.Date @map("end_date")

  // Admin Review
  adminNotes       String?          @db.Text @map("admin_notes")

  // Soft Delete
  deletedAt        DateTime?        @map("deleted_at")

  // Metadata
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  // Relations
  donations        Donation[]

  // Indexes
  @@index([organizerId])

  @@index([organizationId])

  @@index([status])

  @@index([featured])

  @@index([createdAt])

  @@map("campaigns")
}
// ─────────────────────────────────────────────────────────────────────────────
// DONATION
// Records a donor's contribution to a campaign.
// Payment processing details are stored separately in Payment.
// ─────────────────────────────────────────────────────────────────────────────

model Donation {
  id              String           @id @default(uuid()) @db.Uuid

  // Donor
  donorId         String           @map("donor_id") @db.Uuid
  donor           Profile          @relation(fields: [donorId], references: [id])

  // Campaign
  campaignId      String           @map("campaign_id") @db.Uuid
  campaign        Campaign         @relation(fields: [campaignId], references: [id])

  // Donation Details
  amount          Decimal          @db.Decimal(12,2)

  currency        String           @default("INR")

  isAnonymous     Boolean          @default(false) @map("is_anonymous")

  message         String?          @db.Text

  status          DonationStatus   @default(PENDING)

  donatedAt       DateTime?        @map("donated_at")

  createdAt       DateTime         @default(now()) @map("created_at")

  updatedAt       DateTime         @updatedAt @map("updated_at")

  // Relations

  payment         Payment?

  // Indexes

  @@index([donorId])

  @@index([campaignId])

  @@index([status])

  @@index([createdAt])

  @@map("donations")
}
// ─────────────────────────────────────────────────────────────────────────────
// PAYMENT
// Stores payment gateway transaction details.
// One Payment belongs to exactly one Donation.
// ─────────────────────────────────────────────────────────────────────────────

model Payment {
  id                  String           @id @default(uuid()) @db.Uuid

  // Relation
  donationId          String           @unique @map("donation_id") @db.Uuid
  donation            Donation         @relation(fields: [donationId], references: [id], onDelete: Cascade)

  // Gateway
  gateway             PaymentGateway   @default(MOCK)

  gatewayOrderId      String?          @unique @map("gateway_order_id")

  gatewayPaymentId    String?          @unique @map("gateway_payment_id")

  gatewaySignature    String?          @map("gateway_signature")

  // Financial
  currency            String           @default("INR")

  amount              Decimal          @db.Decimal(12,2)

  fee                 Decimal?         @default(0) @db.Decimal(12,2)

  tax                 Decimal?         @default(0) @db.Decimal(12,2)

  netAmount           Decimal?         @db.Decimal(12,2) @map("net_amount")

  // Status
  status              PaymentStatus    @default(PENDING)

  failureReason       String?          @db.Text @map("failure_reason")

  gatewayResponse     Json?            @map("gateway_response")

  processedAt         DateTime?        @map("processed_at")

  // Refund

  refundedAmount      Decimal?         @default(0) @db.Decimal(12,2) @map("refunded_amount")

  refundReason        String?          @db.Text @map("refund_reason")

  refundedAt          DateTime?        @map("refunded_at")

  // Metadata

  createdAt           DateTime         @default(now()) @map("created_at")

  updatedAt           DateTime         @updatedAt @map("updated_at")

  // Indexes

  @@index([status])

  @@index([gateway])

  @@index([processedAt])

  @@map("payments")
}