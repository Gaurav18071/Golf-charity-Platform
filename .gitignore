# ─────────────────────────────────────────────────────────────────────────────
# GOLF CHARITY PLATFORM — .gitignore
# ─────────────────────────────────────────────────────────────────────────────

# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js build output
/.next/
/out/
/build

# Environment variables — NEVER commit secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.production
.env.staging
# DO commit .env.example (it has no secrets)
!.env.example

# Prisma
prisma/migrations/dev.db
prisma/*.db

# Testing
/coverage

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# OS files
.DS_Store
Thumbs.db
*.pem

# Vercel
.vercel

# TypeScript
*.tsbuildinfo
next-env.d.ts

# IDE
.vscode
.idea
*.swp
*.swo

# Python (venv used locally for scripts)
.venv/
__pycache__/
*.pyc
